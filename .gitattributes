# Normalización general: Git decide según el SO
* text=auto

# Código fuente: siempre LF en el repo, conversión automática en checkout
*.cpp    text eol=lf
*.hpp    text eol=lf
*.h      text eol=lf
*.c      text eol=lf
*.vert   text eol=lf
*.frag   text eol=lf
*.glsl   text eol=lf

# Archivos de proyecto de Visual Studio: CRLF siempre
*.sln    text eol=crlf
*.vcxproj text eol=crlf
*.props  text eol=crlf

# Scripts
*.bat    text eol=crlf
*.sh     text eol=lf
*.py     text eol=lf

# Archivos binarios: sin conversión
*.spv    binary
*.lib    binary
*.dll    binary
*.exe    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.bmp    binary
*.tga    binary
*.dds    binary
*.ktx    binary
*.fbx    binary
*.obj    binary
*.ttf    binary
*.otf    binary