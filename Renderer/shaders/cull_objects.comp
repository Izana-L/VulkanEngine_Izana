#version 450
#extension GL_GOOGLE_include_directive : require

// Frustum culling and draw generation of the opaque pass.
//
// One invocation per object of the frame's object buffer. An object that
// is active, belongs to the pass and whose bounding ellipsoid (the mesh
// bounding sphere placed by its model matrix, mesh_table.glsl) is not
// entirely outside a frustum plane reserves a slot in its draw bucket with
// one atomicAdd and writes a complete indexed draw command there: its mesh
// range in the geometry pool and firstInstance = its object index, which
// mesh.vert receives as gl_InstanceIndex.
//
// A draw bucket is the set of opaque objects that share a pipeline and a
// triangle winding. The CPU assigns every object to a bucket (its index is
// in the object flags) and reserves for each one a range of the command
// buffer as large as its object count (frame.draw_buckets). The CPU then
// records one vkCmdDrawIndexedIndirectCount per bucket, reading the number
// of draws from the counter of the bucket, without knowing how many
// objects survived.
//
// The slots of a bucket are taken in no particular order, so the draw
// order changes from frame to frame: opaque surfaces lose their
// front-to-back order, and coplanar surfaces with equal depth may flicker
// between each other.
//
// Recorded before the render pass, after the reset of draw_count (fill +
// barrier TRANSFER -> COMPUTE) and followed by a barrier COMPUTE ->
// DRAW_INDIRECT (Renderer::Record_command_buffer).
//
// The frustum test is optional (Cull_Push_Constants::frustum_culling): with
// it off the pass only compacts the active objects into their buckets.
//
// The local size is GPU_CULL_GROUP_SIZE (common/gpu_shared.h), the divisor of
// the CPU dispatch (Renderer_System::Dispatch_group_count). The header is
// included here, before the layout, because the size is read right below.
#include "common/gpu_shared.h"

layout(local_size_x = GPU_CULL_GROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

#include "common/frame_set.glsl"
#include "common/scene_data.glsl"
#include "common/mesh_table.glsl"

// EXACT mirror of Renderer_System::Cull_Push_Constants (C++), 16 bytes.
layout(push_constant) uniform Cull_Push_Constants
{
    uint object_count;       // offset 0: objects [0, object_count) are processed
    uint command_capacity;   // offset 4: entries of draw_commands
    uint pass_bit;           // offset 8: RENDER_PASS_* an object needs
    uint frustum_culling;    // offset 12: 0 = every active object is drawn
} push;

// Mirror of VkDrawIndexedIndirectCommand: five 32-bit values, std430
// stride 20, the stride the indirect draw is recorded with.
struct Draw_Command
{
    uint index_count;
    uint instance_count;
    uint first_index;
    int  vertex_offset;
    uint first_instance;
};

// Set 0, binding 6 (Binding_Per_Frame::Draw_Commands). The commands of
// bucket b occupy [frame.draw_buckets[b].first_command,
// first_command + capacity).
layout(set = GPU_SET_PER_FRAME, binding = GPU_BINDING_DRAW_COMMANDS, std430) writeonly buffer Draw_Command_Buffer
{
    Draw_Command commands[];
} draw_commands;

// Set 0, binding 7 (Binding_Per_Frame::Draw_Count). EXACT mirror of
// Renderer_System::Draw_Count_GPU: the count buffers of the indirect
// draws, one counter per bucket, and the total of all of them.
layout(set = GPU_SET_PER_FRAME, binding = GPU_BINDING_DRAW_COUNT, std430) buffer Draw_Count
{
    uint total_draw_count;
    uint _pad0;
    uint _pad1;
    uint _pad2;
    uint bucket_draw_count[MAX_DRAW_BUCKETS];
} draw_count;

// False when the bounding ellipsoid of the mesh, placed by _model, lies
// entirely on the outer side of one plane: signed distance of its center
// below minus its half-width along the plane normal (mesh_table.glsl). A
// volume crossing a plane, the near one included, is kept: it is partly
// visible. Same test as CoreTypes::Frustum::Intersects_ellipsoid, which
// culls the transparent items on the CPU.
bool Ellipsoid_in_frustum(mat4 _model, vec4 _local_sphere)
{
    const vec3 center = Bounding_ellipsoid_center(_model, _local_sphere);

    for (int p = 0; p < FRUSTUM_PLANE_COUNT; ++p)
    {
        const vec4 plane = frame.frustum_planes[p];

        if (dot(plane.xyz, center) + plane.w < -Bounding_ellipsoid_extent(_model, _local_sphere.w, plane.xyz))
            return false;
    }

    return true;
}

void main()
{
    const uint object_index = gl_GlobalInvocationID.x;

    // The dispatch is rounded up to whole groups.
    if (object_index >= push.object_count)
        return;

    const Object object = object_buffer.objects[object_index];

    if ((object.flags & OBJECT_FLAG_ACTIVE) == 0u || (object.flags & push.pass_bit) == 0u)
        return;

    const Mesh_Info mesh = mesh_table.meshes[object.mesh_index];

    if (push.frustum_culling != 0u && !Ellipsoid_in_frustum(object.model, mesh.bounding_sphere))
        return;

    // The bucket the CPU assigned to the object. The mask keeps a corrupt
    // index inside the table.
    const uint bucket_index = (object.flags >> OBJECT_FLAG_BUCKET_SHIFT) & OBJECT_FLAG_BUCKET_MASK;

    if (bucket_index >= uint(MAX_DRAW_BUCKETS))
        return;

    const Draw_Bucket bucket = frame.draw_buckets[bucket_index];

    atomicAdd(draw_count.total_draw_count, 1u);

    const uint bucket_slot = atomicAdd(draw_count.bucket_draw_count[bucket_index], 1u);

    // Cannot happen while the capacity of a bucket is its object count and
    // the buckets fit the command buffer, which the Renderer guarantees;
    // the guard keeps a broken invariant from writing into the range of
    // another bucket or past the buffer.
    const uint slot = bucket.first_command + bucket_slot;

    if (bucket_slot >= bucket.capacity || slot >= push.command_capacity)
        return;

    draw_commands.commands[slot].index_count    = mesh.index_count;
    draw_commands.commands[slot].instance_count = 1u;
    draw_commands.commands[slot].first_index    = mesh.first_index;
    draw_commands.commands[slot].vertex_offset  = mesh.vertex_offset;
    draw_commands.commands[slot].first_instance = object_index;
}
