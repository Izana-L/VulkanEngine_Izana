<?xml version="1.0" encoding="utf-8"?>
<!--
  Shader compilation for Renderer.vcxproj.

  MSBuild imports this file automatically into every project in this folder
  (Directory.Build.targets, supported by C++ projects since Visual Studio
  2019), so it takes effect without an Import in the .vcxproj. It is the
  only project in this folder. A Directory.Build.targets added in a parent
  folder is not imported while this one exists: MSBuild stops at the first
  one it finds walking up from the project.

  This target is the only place where shaders are compiled:
    - DisableFastUpToDateCheck makes Visual Studio hand every build to
      MSBuild, so editing only a shader or a common/*.glsl include is never
      treated as "up to date". MSBuild's own incremental checks keep a build
      with no changes fast: the C++ compiler skips up-to-date files, and
      this target is skipped when every .spv is newer than its inputs.
    - Inputs / Outputs: each stage file maps to its own .spv, so editing one
      stage recompiles only that stage. The files in common/ are included by
      several stages and cannot be mapped to one output, so editing any of
      them recompiles every stage. This file is an input as well, so a
      change to the compiler options recompiles everything.
    - One definition for every configuration, with an explicit glslc
      target environment (RendererShaderTargetEnv) matching the Vulkan 1.3
      device the engine requires (Vulkan_Device rejects anything older).

  Output: Renderer/shaders/compiled/<file>.<stage>.spv. The Game project
  deploys that folder next to the executable (shaders/), where the Renderer
  loads it from (Shader_Paths.hpp).

  A PreBuildEvent that runs glslc must not exist in Renderer.vcxproj: it
  runs before this target on every build, recompiles every stage without
  the target environment, and leaves every .spv newer than its inputs, so
  this target is always skipped. Reject_Shader_PreBuildEvent fails the
  build if one is added back (for example from the project properties in
  Visual Studio).

  Requirement: the VULKAN_SDK environment variable, set by the Vulkan SDK
  installer; glslc.exe ships with the SDK.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>

    <RendererShaderDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\shaders\'))</RendererShaderDir>
    <RendererShaderOutputDir>$(RendererShaderDir)compiled\</RendererShaderOutputDir>
    <RendererShaderTargetEnv>vulkan1.3</RendererShaderTargetEnv>
    <RendererGlslc>$(VULKAN_SDK)\Bin\glslc.exe</RendererGlslc>
  </PropertyGroup>

  <ItemGroup>
    <!-- One item per shader stage; each produces <file>.<stage>.spv. -->
    <RendererShaderStage Include="$(RendererShaderDir)*.vert;$(RendererShaderDir)*.frag;$(RendererShaderDir)*.comp" />

    <!-- Files included by the stages (#include "common/..."). -->
    <RendererShaderInclude Include="$(RendererShaderDir)common\**\*.glsl" />
  </ItemGroup>

  <!--
    Fails the build when the project's PreBuildEvent invokes glslc.

    PreBuildEvent is an item definition (ItemDefinitionGroup metadata), not
    a property: its Command is read from a probe item created here, which
    receives the definition's metadata like any PreBuildEvent item, and is
    removed again before the PreBuildEvent target runs.
  -->
  <Target Name="Reject_Shader_PreBuildEvent"
          BeforeTargets="PreBuildEvent">

    <ItemGroup>
      <PreBuildEvent Include="Renderer_Shader_PreBuildEvent_Probe" />
    </ItemGroup>

    <PropertyGroup>
      <_RendererPreBuildCommand>@(PreBuildEvent->WithMetadataValue('Identity', 'Renderer_Shader_PreBuildEvent_Probe')->'%(Command)')</_RendererPreBuildCommand>
    </PropertyGroup>

    <ItemGroup>
      <PreBuildEvent Remove="Renderer_Shader_PreBuildEvent_Probe" />
    </ItemGroup>

    <Error Condition="$(_RendererPreBuildCommand.ToLowerInvariant().Contains('glslc'))"
           Text="Renderer.vcxproj has a PreBuildEvent that runs glslc. Shaders are compiled only by the Compile_Renderer_Shaders target of Directory.Build.targets: remove the PreBuildEvent (Project Properties > Build Events > Pre-Build Event, every configuration)." />
  </Target>

  <Target Name="Compile_Renderer_Shaders"
          BeforeTargets="ClCompile"
          DependsOnTargets="Reject_Shader_PreBuildEvent"
          Inputs="@(RendererShaderStage);@(RendererShaderInclude);$(MSBuildThisFileFullPath)"
          Outputs="@(RendererShaderStage->'$(RendererShaderOutputDir)%(Filename)%(Extension).spv')">

    <Error Condition="'$(VULKAN_SDK)' == ''"
           Text="VULKAN_SDK is not set: install the Vulkan SDK, which provides glslc.exe, and restart Visual Studio." />
    <Error Condition="!Exists('$(RendererGlslc)')"
           Text="glslc.exe not found at '$(RendererGlslc)'." />

    <MakeDir Directories="$(RendererShaderOutputDir)" />

    <!-- Batched over the stages that are out of date: one glslc call each.
         A compile error fails the build. -->
    <Exec Command="&quot;$(RendererGlslc)&quot; --target-env=$(RendererShaderTargetEnv) &quot;%(RendererShaderStage.FullPath)&quot; -o &quot;$(RendererShaderOutputDir)%(RendererShaderStage.Filename)%(RendererShaderStage.Extension).spv&quot;" />
  </Target>

</Project>
