<?xml version="1.0" encoding="utf-8"?>
<!--
  Deployment of the engine's read-only data next to Game.exe.

  MSBuild imports this file automatically into every project in this folder
  (Directory.Build.targets); Game.vcxproj is the only one.

  The engine resolves every data file against the directory of the
  executable (Platform::Filesystem::Get_asset_root), never against the
  current working directory. After each build this target copies into
  $(OutDir):
    shaders\   Renderer/shaders/compiled/*.spv (compiled by the Renderer
               project, which is built before Game because Game links
               Renderer.lib)
    input\     Input/jsons/*.json
    assets\    Game/assets/** (directory structure kept)
  The output folder is then self-contained: the executable runs from any
  launch directory (double click, Visual Studio, a console elsewhere) and
  the folder can be packaged as it is.

  Copies skip unchanged files, so a build with no changes copies nothing.
  DisableFastUpToDateCheck makes Visual Studio run this target even when
  only a shader or a data file changed and Game.exe itself is up to date;
  MSBuild's incremental checks keep that build fast.

  Data generated at run time (the pipeline cache) is not written here: it
  goes to the per-user data directory (Platform::Filesystem::
  Get_user_data_directory).
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>

    <GameRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</GameRepositoryRoot>
    <GameShaderSourceDir>$(GameRepositoryRoot)Renderer\shaders\compiled\</GameShaderSourceDir>
    <GameInputSourceDir>$(GameRepositoryRoot)Input\jsons\</GameInputSourceDir>
    <GameAssetSourceDir>$(GameRepositoryRoot)Game\assets\</GameAssetSourceDir>
  </PropertyGroup>

  <Target Name="Deploy_Game_Data"
          AfterTargets="Build">

    <!-- Evaluated when the target runs, after the Renderer compiled its
         shaders, so stages added since the project was loaded are included. -->
    <ItemGroup>
      <GameDeployShader Include="$(GameShaderSourceDir)*.spv" />
      <GameDeployInput Include="$(GameInputSourceDir)*.json" />
      <GameDeployAsset Include="$(GameAssetSourceDir)**\*" />
    </ItemGroup>

    <Error Condition="'@(GameDeployShader)' == ''"
           Text="No compiled shaders in '$(GameShaderSourceDir)': build the Renderer project first (it compiles them)." />

    <Copy SourceFiles="@(GameDeployShader)"
          DestinationFolder="$(OutDir)shaders\"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(GameDeployInput)"
          DestinationFolder="$(OutDir)input\"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(GameDeployAsset)"
          DestinationFiles="@(GameDeployAsset->'$(OutDir)assets\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
